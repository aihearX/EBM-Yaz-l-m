# EBM SmartClinical - ortam degiskenleri
# Kopyalayip .env olarak kaydedin. Uretimde SC_SECRET_KEY mutlaka degistirilmeli.

SC_ORTAM=gelistirme            # gelistirme | test | uretim
SC_SECRET_KEY=degistir-beni-uretimde-32-karakter
SC_DB_URL=sqlite:///./veri/smartclinical.db
# SC_DB_URL=postgresql+psycopg://smartclinical:parola@localhost:5432/smartclinical

# Oturum suresi (dakika). 21 CFR Part 11 icin kisa tutulmasi onerilir.
SC_OTURUM_SURESI_DK=30

# Turkce Klinik BDM (buyuk dil modeli) baglantisi.
# Model hastane ici sunucuda calisir; veri kurum disina cikmaz.
SC_BDM_SAGLAYICI=kural          # kural | ollama | vllm | llamacpp
SC_BDM_URL=http://localhost:11434
SC_BDM_MODEL=ebm-klinik-tr-7b-q4
SC_BDM_ZAMAN_ASIMI_SN=60

# Gomme (embedding) modeli - RAG icin
SC_GOMME_MODEL=ebm-klinik-tr-embed-v2
SC_GOMME_URL=http://localhost:8081

# Dosya depolama (TMF belgeleri)
SC_DOSYA_DIZINI=./yuklemeler

# HBYS / EDC entegrasyon
SC_FHIR_SUNUCU_URL=
SC_FHIR_TOKEN=
