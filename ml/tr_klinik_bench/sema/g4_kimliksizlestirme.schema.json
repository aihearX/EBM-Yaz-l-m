{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebm-cro.com/tr-klinik-bench/0.3/g4_kimliksizlestirme.schema.json",
  "title": "g4_kimliksizlestirme",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "metin",
    "varliklar"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^G4-"
    },
    "metin": {
      "type": "string"
    },
    "varliklar": {
      "type": "array",
      "items": {
        "enum": [
          "AD",
          "TCKN",
          "TELEFON",
          "EPOSTA",
          "IBAN",
          "PLAKA",
          "TARIH",
          "KAYIT_NO",
          "KURUM",
          "ADRES",
          "IL",
          "YAS"
        ]
      }
    },
    "klinik_terimler": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Maskelenmemesi gereken klinik terimler"
    },
    "etiketleyen": {
      "type": "string"
    },
    "ikinci_etiketleyen": {
      "type": [
        "string",
        "null"
      ]
    },
    "ikinci_etiket": {
      "type": [
        "string",
        "null"
      ]
    },
    "uyum": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hakem_karari": {
      "type": [
        "string",
        "null"
      ]
    },
    "zorluk": {
      "enum": [
        "kolay",
        "orta",
        "zor"
      ]
    },
    "etiket_tarihi": {
      "type": "string"
    },
    "notlar": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}